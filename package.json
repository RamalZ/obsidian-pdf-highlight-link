{
  "name": "pdf-highlight-link",
  "version": "0.2.1",
  "description": "在 Obsidian 内置 PDF 阅读器中复制选区/框选链接，并按反向链接渲染高亮",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs --production",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/run.ts",
    "smoke": "node test/smoke.cjs",
    "deploy": "node scripts/deploy.mjs",
    "package": "node scripts/package.mjs"
  },
  "keywords": [
    "obsidian",
    "pdf",
    "highlight"
  ],
  "author": "Ramal",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.7.2"
  }
}
