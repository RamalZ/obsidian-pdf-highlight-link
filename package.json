{
  "name": "pdf-highlight-link",
  "version": "0.2.6",
  "description": "Copy selection or region links in Obsidian's built-in PDF viewer and render highlights from backlinks.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs --production",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/run.ts",
    "smoke": "node test/smoke.cjs",
    "deploy": "node scripts/deploy.mjs",
    "package": "node scripts/package.mjs"
  },
  "keywords": [
    "obsidian",
    "pdf",
    "highlight"
  ],
  "author": "Ramal",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.7.2"
  }
}
